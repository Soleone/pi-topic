{
  "name": "pi-topic",
  "version": "0.1.0",
  "description": "A Pi extension that shows a persistent session topic line above the input",
  "private": true,
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "test",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "validate": "npm pack --dry-run",
    "demo:build": "node demo/browser/build.mjs && showcase terminal demo/browser --out dist/browser",
    "demo": "node demo/browser/build.mjs && showcase terminal demo/browser --out dist/browser --serve",
    "media:capture": "node demo/capture.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@soleone/showcase": "github:Soleone/showcase#658b1b5",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.10",
    "typescript": "^5.9.3"
  }
}
