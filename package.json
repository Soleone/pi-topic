{
  "name": "pi-topic",
  "version": "0.1.0",
  "description": "A Pi extension that shows a persistent session topic line above the input",
  "private": true,
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "test",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "validate": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
